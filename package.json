{
  "name": "live-translation",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "server": "npm -w @lt/server run dev",
    "demo": "npm -w @lt/demo run build",
    "eval": "npm -w @lt/eval run eval --",
    "detect": "npm -w @lt/eval run detect --"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
