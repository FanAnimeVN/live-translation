{
  "name": "manga-live-translator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/ui-qa.mjs",
    "test:desktop": "node scripts/desktop-reader-qa.mjs",
    "test:lettering": "node scripts/lettering-qa.mjs",
    "test:art": "node scripts/art-lettering-qa.mjs",
    "test:options": "node scripts/options-qa.mjs",
    "test:connection": "node scripts/connection-qa.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0", "zod": "^4.1.0" },
  "devDependencies": {
    "@types/chrome": "^0.1.0", "@types/node": "^24.0.0",
    "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0", "playwright": "^1.56.0", "tsx": "^4.20.0", "typescript": "^5.9.0"
  }
}
